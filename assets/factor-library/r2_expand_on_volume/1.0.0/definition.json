  "description": "[带宽-量能交互因子] 带宽5日变化（扩张方向）与5日平滑量比的乘积，用平滑抑制当日量噪声，检验放量伴随带宽扩张是否含增量信息。",
  "formula": "(4*population_std20[t]-4*population_std20[t-5]) * rolling_mean(volume/SMA20(volume),5)",
  "max_lookback": 25,
  "scale_invariant": false,
  "status": "accepted",
  "output_columns": [
    "expand_on_volume"
  ],
